# Скопіюйте цей файл у .env і заповніть значення. .env вже в .gitignore.

# --- FRED (макро-дані США) ---
# Безкоштовна реєстрація: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# --- PostgreSQL / TimescaleDB ---
# DB_HOST=localhost — для підключення з хоста (psql, VSCode PostgreSQL
# extension). Контейнер app всередині docker compose підключається
# до бази за іменем сервісу "db" автоматично (перевизначено в
# docker-compose.yml), це значення тут можна не чіпати.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=invest_agent
DB_USER=invest_agent
DB_PASSWORD=

# --- Telegram ---
# Бот: створити через @BotFather, TELEGRAM_CHAT_ID — id чату/користувача,
# кому бот надсилатиме повідомлення (можна дізнатись через @userinfobot
# або getUpdates після першого повідомлення боту).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
